---
// App mark: green rounded square with an "A", same as the chat app (.logo in chat.albena.ai).
interface Props { size?: number; id?: string }
const { size = 20 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect width="32" height="32" rx="9" fill="#22c55e" />
  <text x="16" y="23" font-family="Inter, system-ui, sans-serif" font-size="20" font-weight="700" text-anchor="middle" fill="#052e16">A</text>
</svg>
