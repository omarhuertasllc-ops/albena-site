{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "albena-portal",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // Request URLs can contain magic tokens. Do not enable automatic request logs.
  "observability": { "enabled": false },
  // Static portal UI (portal/web, `npm run build`). Worker first so every asset gets the security headers.
  "assets": { "directory": "../web/dist", "binding": "ASSETS", "html_handling": "auto-trailing-slash", "not_found_handling": "404-page", "run_worker_first": true },
  "send_email": [{ "name": "EMAIL" }],
  "triggers": { "crons": ["23 * * * *"] },
  "routes": [{ "pattern": "account.albena.ai", "custom_domain": true }],
  "d1_databases": [{ "binding": "DB", "database_name": "albena_portal", "database_id": "e4fa18b9-bfa6-4d22-a310-1b6929928002", "migrations_dir": "migrations" }],
  "ratelimits": [
    { "name": "AUTH_IP_LIMITER", "namespace_id": "1101", "simple": { "limit": 20, "period": 60 } },
    { "name": "AUTH_EMAIL_LIMITER", "namespace_id": "1102", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "PORTAL_ORIGIN": "https://account.albena.ai",
    "RP_ID": "albena.ai",
    "MAIL_FROM": "accounts@albena.ai",
    "MAIL_PROVIDER": "cloudflare",
    // Sign in with Microsoft (single-tenant Entra ID). ENTRA_CLIENT_ID empty = SSO off. Secret ENTRA_CLIENT_SECRET.
    "ENTRA_TENANT_ID": "a4852d28-a73d-457b-87dc-d289eb20bf16", "ENTRA_CLIENT_ID": "f40cdeba-ea41-46d7-8d80-0c1dc67f7b64",
        // Early access: the Cloudflare Access group shared with chat/console (docs/EARLY-ACCESS.md). Secret: CF_ACCESS_READ_TOKEN.
        "CF_ACCOUNT_ID": "d59bc8ce599de891f475d1cd8af22370", "EARLY_ACCESS_GROUP_ID": "",
    // Stripe Price IDs (test mode). Placeholders: empty means "plan not configured" and checkout answers 503.
    "PRICE_BYO_MONTHLY": "", "PRICE_BYO_ANNUAL": "",
    "PRICE_HUB_MAC_MONTHLY": "", "PRICE_HUB_MAC_ANNUAL": "", "PRICE_HUB_MAC_HARDWARE": "",
    "PRICE_HUB_NVIDIA_MONTHLY": "", "PRICE_HUB_NVIDIA_ANNUAL": "", "PRICE_HUB_NVIDIA_HARDWARE": "",
    // ALB-SEC-1: chain-break alerts to Obvera Event Management. Secret OBVERA_EVENTS_KEY (scope events.ingest only).
    "OBVERA_EVENTS_URL": "https://ohllc-obvera.dbaomarhuertasllc.com/api/obvera/client/eventhub/ingest"
  }
  ,
  // STAGING (deploy.yml deploy-staging). Separate worker + separate D1 so migrations and tests never touch production data.
  // Wrangler does not inherit bindings or vars into an env, so everything is repeated.
  // after the one-time setup in docs/PIPELINE.md (nothing here has been created yet).
  "env": {
    "staging": {
      "name": "albena-portal-staging",
      "workers_dev": true,
      "routes": [],
      "observability": { "enabled": false },
      "assets": { "directory": "../web/dist", "binding": "ASSETS", "html_handling": "auto-trailing-slash", "not_found_handling": "404-page", "run_worker_first": true },
      "send_email": [{ "name": "EMAIL" }],
      "triggers": { "crons": [] },
      "d1_databases": [{ "binding": "DB", "database_name": "albena_portal_staging", "database_id": "84652d20-b3cb-4d8e-be10-e92047f9d384", "migrations_dir": "migrations" }],
      "ratelimits": [
        { "name": "AUTH_IP_LIMITER", "namespace_id": "1201", "simple": { "limit": 20, "period": 60 } },
        { "name": "AUTH_EMAIL_LIMITER", "namespace_id": "1202", "simple": { "limit": 5, "period": 60 } }
      ],
      "vars": {
        // "test": mail is redacted and not sent outside production (see src/auth/mail.ts); never "production" here.
        "ENVIRONMENT": "test",
        "PORTAL_ORIGIN": "https://albena-portal-staging.albena-site.workers.dev",
        "RP_ID": "albena-portal-staging.albena-site.workers.dev",
        "MAIL_FROM": "accounts@albena.ai",
        "MAIL_PROVIDER": "dev",
        "ENTRA_TENANT_ID": "a4852d28-a73d-457b-87dc-d289eb20bf16", "ENTRA_CLIENT_ID": "f40cdeba-ea41-46d7-8d80-0c1dc67f7b64",
        // Early access: the Cloudflare Access group shared with chat/console (docs/EARLY-ACCESS.md). Secret: CF_ACCESS_READ_TOKEN.
        "CF_ACCOUNT_ID": "d59bc8ce599de891f475d1cd8af22370", "EARLY_ACCESS_GROUP_ID": "",
        "PRICE_BYO_MONTHLY": "", "PRICE_BYO_ANNUAL": "",
        "PRICE_HUB_MAC_MONTHLY": "", "PRICE_HUB_MAC_ANNUAL": "", "PRICE_HUB_MAC_HARDWARE": "",
        "PRICE_HUB_NVIDIA_MONTHLY": "", "PRICE_HUB_NVIDIA_ANNUAL": "", "PRICE_HUB_NVIDIA_HARDWARE": ""
      }
    }
  }
  // EMAIL is Cloudflare Email Sending: onboard the MAIL_FROM domain first (wrangler email sending enable albena.ai).
  // Support view-as (Cloudflare Access): secrets TEAM_DOMAIN (purple-firefly-9815.cloudflareaccess.com), ADMIN_AUD (the existing admin Access app AUD tag),
  // SUPPORT_ADMIN_EMAILS (comma-separated allowlist). Access destinations: account.albena.ai/support/* and account.albena.ai/api/support/* (customer ops: invites, manual plans, orders, reserved Hubs, license keys).
  // Secrets: ENTRA_CLIENT_SECRET (Sign in with Microsoft), TURNSTILE_SECRET_KEY, PORTAL_SECRETS (random HMAC privacy key), STRIPE_SECRET_KEY (sk_test_), STRIPE_WEBHOOK_SECRET.
}
