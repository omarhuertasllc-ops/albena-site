---
import Auth from '../layouts/Auth.astro';
import Turnstile from '../components/Turnstile.astro';
---
<Auth title="Sign in">
  <div>
    <h1>Sign in to your account</h1>
    <p class="mut mt-s">Manage your plan, Hubs and household.</p>
  </div>
  <form id="login-form" class="stack lg" novalidate>
    <div class="field">
      <label for="email">Email address</label>
      <input class="input lg" id="email" name="email" type="email" autocomplete="email webauthn" inputmode="email" required aria-describedby="email-err" placeholder="you@example.com" />
      <p class="err" id="email-err"></p>
    </div>
    <Turnstile action="magic_login" />
    <button class="btn btn-primary btn-lg" id="send" type="submit">Email me a sign-in link</button>
    <p class="form-status" id="status" role="status" aria-live="polite"></p>
  </form>
  <p class="or" aria-hidden="true">or</p>
  <button class="btn btn-lg" id="passkey" type="button">
    <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="3.5"/><path d="M10.5 10.5 17 17M14 14l2-2M12 12l1.5-1.5"/></svg>
    Sign in with passkey
  </button>
  <a class="btn btn-lg" id="microsoft" href="/api/auth/microsoft/start" hidden>
    <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path fill="#f25022" d="M2 2h7.5v7.5H2z"/><path fill="#7fba00" d="M10.5 2H18v7.5h-7.5z"/><path fill="#00a4ef" d="M2 10.5h7.5V18H2z"/><path fill="#ffb900" d="M10.5 10.5H18V18h-7.5z"/></svg>
    Sign in with Microsoft
  </a>
  <p class="mut small">By continuing you agree to the <a class="tlink" href="https://albena.ai/terms">Terms</a> and <a class="tlink" href="https://albena.ai/privacy">Privacy Policy</a>.</p>
  <script>import '../scripts/login';</script>
</Auth>
